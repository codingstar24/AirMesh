# ----------------------------------------------------------------------------
# AirMesh - Git Ignore Configuration
# ----------------------------------------------------------------------------

# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# User Data & Shared Storage
# (Do NOT commit personal media, photos, or videos to public Git)
shared/*
!shared/.gitkeep
shared/.thumbs/
*.part

# Temporary & Test files
*.bin
*.tmp
*.log
.temp/
scratch/
test_*.zip

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
